<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ec.edu.udla.fitsyncpro.UI.PanelMiPlan">
  <grid id="root" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="8" left="8" bottom="8" right="8"/>
    <constraints>
      <xy x="0" y="0" width="800" height="600"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="norte" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="line" title="Mi plan de entrenamiento"/>
        <children>
          <component id="l1" class="javax.swing.JLabel">
            <constraints/>
            <properties>
              <text value="Socio:"/>
            </properties>
          </component>
          <component id="c1" class="javax.swing.JComboBox" binding="cmbSocio">
            <constraints/>
            <properties>
              <model/>
            </properties>
          </component>
          <component id="l2" class="javax.swing.JLabel">
            <constraints/>
            <properties>
              <text value="Día:"/>
            </properties>
          </component>
          <component id="c2" class="javax.swing.JComboBox" binding="cmbDia">
            <constraints/>
            <properties/>
          </component>
          <component id="l3" class="javax.swing.JLabel" binding="lblResumen">
            <constraints/>
            <properties>
              <text value="Resumen..."/>
            </properties>
          </component>
        </children>
      </grid>
      <splitpane id="centro">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <orientation value="1"/>
        </properties>
        <border type="none"/>
        <children>
          <scrollpane id="sp1">
            <constraints>
              <splitpane position="left"/>
            </constraints>
            <properties/>
            <border type="line" title="Ejercicios asignados"/>
            <children>
              <component id="lst1" class="javax.swing.JList" binding="listaEjercicios">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>
          <scrollpane id="sp2">
            <constraints>
              <splitpane position="right"/>
            </constraints>
            <properties/>
            <border type="line" title="Videotutorial (guía autónoma)"/>
            <children>
              <component id="txt1" class="javax.swing.JTextArea" binding="txtVideo">
                <constraints/>
                <properties>
                  <editable value="false"/>
                  <lineWrap value="true"/>
                </properties>
              </component>
            </children>
          </scrollpane>
        </children>
      </splitpane>
    </children>
  </grid>
</form>
